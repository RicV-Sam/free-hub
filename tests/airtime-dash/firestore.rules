// Emulator fixture only. Do not replace production Club rules with this file.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} { allow read: if request.auth != null && request.auth.uid == userId; }
    match /admins/{userId} { allow read: if request.auth != null && request.auth.uid == userId; }
    match /{document=**} { allow read, write: if false; }
  }
}
