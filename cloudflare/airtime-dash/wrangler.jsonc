{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freehub-airtime-dash",
  "main": "src/worker.mjs",
  "account_id": "0c8e4f120908b5df6917141b8b047010",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "DASH", "class_name": "AirtimeDash" }] },
  "migrations": [{ "tag": "dash-sqlite-v1", "new_sqlite_classes": ["AirtimeDash"] }],
  "vars": {
    "FIREBASE_PROJECT_ID": "freehub-3206e",
    "ALLOWED_ORIGINS": "https://freehub.co.za,https://www.freehub.co.za",
    "TURNSTILE_HOSTNAMES": "freehub.co.za,www.freehub.co.za",
    "RANKED_ENABLED": "false"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
